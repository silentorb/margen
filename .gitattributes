# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf

*.h text eol=lf
*.cpp text eol=lf
*.c text eol=lf
*.cmake text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sh text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf
